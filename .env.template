# Copier ce fichier en .env et remplir les valeurs (le .env n'est jamais commité)

# Lus par docker-compose.yml pour créer la base et sécuriser Qdrant
POSTGRES_USER=<user>
POSTGRES_PASSWORD=<password>
QDRANT_API_KEY=<qdrant-api-key>

# Lu par l'application : mêmes utilisateur et mot de passe que ci-dessus (base et port de docker-compose.yml)
POSTGRES_URL=postgresql://<user>:<password>@localhost:5432/calorvia_rag

# Clé du serveur de modèles (llama-swap et vLLM ne la vérifient pas par défaut, mais elle doit être renseignée)
LLM_SERVER_API_KEY=<llm-api-key>

# Lu par docker-compose.yml : dossier racine des modèles, monté en /models dans les conteneurs vLLM et llama.cpp
MODELS_DIR=/path/to/models

# Lu par l'application : modèles Docling (docling/) et tokenizer de l'embedder (embedder/bge-m3)
MODELS_FOLDER=/path/to/models/rag

# Optionnels. Les adresses se changent par l'URL complète : QDRANT_PORT ou IP_ADDRESS seuls ne modifient pas les URL.
# QDRANT_URL=http://127.0.0.1:6333
# LLM_URL=http://127.0.0.1:8000/v1
# RUNNER_CONFIG_PATH=./experiments/exp14_passages_by_date.toml
# OCR_DEVICE=cpu        # conversion Docling sur le CPU, si le GPU est occupé (plus lent)
